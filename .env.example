# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Firebase Console → Project settings → Your apps (Web app)
# ค่า web config เหล่านี้เป็นแค่ "ที่อยู่" ของโปรเจกต์ เปิดเผยในหน้าเว็บได้ — ความปลอดภัยจริงอยู่ที่ firestore.rules
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ใช้กับสคริปต์ seed เท่านั้น (npm run seed) — path ของไฟล์ service account key ที่เก็บไว้ "นอก" โฟลเดอร์โปรเจกต์
# ⚠️ ห้ามวางไฟล์ key ไว้ใน repo ห้าม commit ห้ามวางเนื้อหาไฟล์ลงใน AI chat
SERVICE_ACCOUNT_PATH=C:/Users/<you>/firebase-keys/baanbrew-service-account.json
